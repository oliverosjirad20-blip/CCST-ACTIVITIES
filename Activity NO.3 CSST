      "cell_type": "code",
      "source": [
        "classify_support <- function(score){\n",
        "\n",
        "  if(score == 3){\n",
        "    return(\"Strongly Supported\")\n",
        "  } else if(score == 2) {\n",
        "    return(\"Moderately Supported\")\n",
        "  } else if(score == 1) {\n",
        "    return(\"Weakly Supported\")\n",
        "  } else {\n",
        "    return(\"No Supported\")\n",
        "  }\n",
        "}\n",
        "classify_support(2)"
